# Copy to .env; do not commit the resulting secrets.
# These defaults are for LOCAL HTTP only. Use compose.production.yaml for HTTPS.
DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_URL=http://localhost:8080
MYSQL_DATABASE=venus_learning
MYSQL_USER=venus
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_ROOT_PASSWORD
MYSQL_HOST=db
MYSQL_PORT=3306
DB_ENGINE=mysql
HTTP_PORT=8080
TRUST_PROXY=true
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Venus Learning <no-reply@example.com>
JUDGE0_URL=
JUDGE0_API_KEY=
# Demo-only public credentials are documented in README.md.
# Disabled by default; also requires DEBUG=true and an explicit seed_demo command.
# Never enable against a public or production database.
ENABLE_DEMO_ACCOUNTS=false

REDIS_URL=redis://redis:6379/0
